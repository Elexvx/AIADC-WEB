# AIADC official site runtime
#
# The official site is an independent frontend application. It does not import
# Lumira frontend/backend source directly; all business content is read from the
# shared Lumira service API.

# Optional shared Lumira service base URL.
# Leave this empty when the public API is served from the same domain as the
# official site, for example https://www.example.com/api/v1/public/aiadc/content.
# Set it only when Lumira is hosted on a different origin, for example:
# LUMIRA_API_BASE=https://api.example.com
LUMIRA_API_BASE=

# Optional site origin used when LUMIRA_API_BASE is empty. On Vercel this can be
# omitted because VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL is available.
# LUMIRA_SITE_ORIGIN=https://www.example.com

# Local-only fallback used when neither LUMIRA_API_BASE nor a deployment/site
# origin is available.
LUMIRA_LOCAL_API_BASE=http://localhost:8080

# Public content API exposed by Lumira for the official site.
LUMIRA_PUBLIC_CONTENT_PATH=/api/v1/public/aiadc/content

# Public activity API exposed by Lumira for the official site.
LUMIRA_ACTIVITIES_PATH=/api/v1/public/aiadc/activities

# Server-side fetch timeout for Lumira requests. Keep this short so public pages
# quickly fall back to bundled content when the content service is slow.
LUMIRA_REQUEST_TIMEOUT_MS=1500

# Optional browser-visible API base for future client-side integrations. Prefer
# LUMIRA_API_BASE for server-side content loading.
NEXT_PUBLIC_API_BASE=

# Aliyun CDN cache refresh.
# Create a RAM user for this project and grant the least privilege needed for
# cdn:RefreshObjectCaches. Do not use the Alibaba Cloud root account key.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Optional. Defaults to cdn.aliyuncs.com.
ALIYUN_CDN_ENDPOINT=cdn.aliyuncs.com

# Default refresh targets used by `npm run refresh:cdn` when no CLI URLs are
# passed. Separate multiple targets with commas or new lines. Directory refresh
# targets must end with `/`.
# ALIYUN_CDN_REFRESH_PATHS=https://www.example.com/

# Optional. Use File for exact URLs or Directory for directory refresh. When
# omitted, the script infers Directory only when every target ends with `/`.
# ALIYUN_CDN_REFRESH_TYPE=Directory
