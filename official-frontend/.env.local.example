# AIADC official site runtime
#
# The official site is an independent frontend application. It does not import
# Lumira frontend/backend source directly; all business content is read from the
# shared Lumira service API.

# Shared Lumira service base URL. In local development this is the Spring Boot
# service started from services/lumira-platform.
LUMIRA_API_BASE=http://localhost:8080

# Public content API exposed by Lumira for the official site.
LUMIRA_PUBLIC_CONTENT_PATH=/api/v1/public/aiadc/content

# Server-side fetch timeout for Lumira requests.
LUMIRA_REQUEST_TIMEOUT_MS=8000

# Optional browser-visible API base for future client-side integrations.
NEXT_PUBLIC_API_BASE=http://localhost:8080
